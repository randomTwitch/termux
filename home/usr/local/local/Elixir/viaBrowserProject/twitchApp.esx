x=File.read("/data/data/com.termux/files/usr/tmp/erl_tmp") |> Tuple.to_list() |> Enum.at(1) |> String.split("#") |> Enum.drop(-1);
Enum.each x, fn x -> System.shell "am start -n tv.twitch.android.app/tv.twitch.android.app.core.LandingActivity -d '"<>x<>"'"; Process.sleep 15000 end
File.open("/data/data/com.termux/files/usr/tmp/erl_tmp",[:write]);
